# Copy to .env and fill in. Never commit .env.

# --- Zotero (read access) ---------------------------------------------------
PAPERFEED_ZOTERO__USER_ID=
PAPERFEED_ZOTERO__API_KEY=
PAPERFEED_ZOTERO__LIBRARY_TYPE=user
PAPERFEED_ZOTERO__COLLECTION=paperfeed/interests
PAPERFEED_ZOTERO__NOTE_TITLE=paperfeed profile

# --- arXiv ------------------------------------------------------------------
# JSON list; the env var must be valid JSON, quotes included.
PAPERFEED_ARXIV__CATEGORIES=["cond-mat.str-el","quant-ph"]
PAPERFEED_ARXIV__ANNOUNCE_TYPES=["new","cross"]
PAPERFEED_ARXIV__MAX_CANDIDATES=300

# --- Bailian (Model Studio): ranking + descriptions, one key ---------------
# Public DashScope-compatible endpoint; use your workspace host if the models
# are not exposed publicly.
PAPERFEED_BAILIAN__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PAPERFEED_BAILIAN__API_KEY=
PAPERFEED_BAILIAN__DECISION_MODEL=decision-model-preview
PAPERFEED_BAILIAN__CHAT_MODEL=qwen3.8-flash
PAPERFEED_BAILIAN__DECISION_CONCURRENCY=8
PAPERFEED_BAILIAN__CHAT_CONCURRENCY=4
# Thinking off for the qwen3 family; use {} if your model id rejects the field.
PAPERFEED_BAILIAN__CHAT_EXTRA_BODY={"enable_thinking": false}

# --- Feishu custom-bot webhook ---------------------------------------------
PAPERFEED_FEISHU__WEBHOOK_URL=
PAPERFEED_FEISHU__CARD_COLOR=blue

# --- Tuning -----------------------------------------------------------------
PAPERFEED_MAX_PAPERS=10
PAPERFEED_MIN_SCORE=0.60
PAPERFEED_AVOID_PENALTY=0.5
PAPERFEED_LANGUAGE=English
# Fewer candidates + verbose logs.
PAPERFEED_DEBUG=false
